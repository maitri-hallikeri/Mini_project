# ============================================================
# CLOUDSHIELD Backend — Environment Configuration Example
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_NAME=CLOUDSHIELD Backend
APP_ENV=development          # development | staging | production
APP_VERSION=0.1.0
API_PREFIX=/api/v1

# --- Database ---
# Default: local SQLite (no extra setup needed for development)
DATABASE_URL=sqlite:///./data/app.db
# To switch to PostgreSQL, change to:
# DATABASE_URL=postgresql://user:password@localhost:5432/cloudshield

# --- Logging ---
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# --- Pipeline ---
# Set to true only after module implementations exist (stubs will raise NotImplementedError)
PIPELINE_ENABLED=false
WINDOW_SECONDS=10

# --- Nginx integration ---
NGINX_ACCESS_LOG_PATH=/var/log/nginx/access.log
NGINX_BLOCKLIST_PATH=/etc/nginx/conf.d/blocklist.conf

# --- Replica health ---
# Comma-separated list of replica base URLs to health-check
REPLICA_URLS=http://app1:8080,http://app2:8080
HEALTH_CHECK_INTERVAL_S=10

# --- Mitigation ---
MITIGATION_DEFAULT_TTL_S=300

# --- Risk thresholds (placeholder — to be tuned by Member 2) ---
RISK_MEDIUM_MIN=30
RISK_HIGH_MIN=60
RISK_CRITICAL_MIN=85

# --- ML detector ---
ML_DETECTOR_ENABLED=false
